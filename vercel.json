{
  "redirects": [
    { "source": "/lost-property", "destination": "/gingabay", "permanent": true },
    { "source": "/freestyle", "destination": "/battles", "permanent": true },
    { "source": "/royal-rumble", "destination": "/battles", "permanent": true },
    { "source": "/royalrumble", "destination": "/battles", "permanent": true },
    { "source": "/RoyalRumble", "destination": "/battles", "permanent": true }
  ],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
